# AI 督学馆后端
NODE_ENV=development
PORT=3001

# 数据库:默认 SQLite(零依赖跑通);要切 PostgreSQL 设 DB_TYPE=postgres 并填连接
DB_TYPE=sqlite
DB_FILE=./data/aidushu.sqlite
# --- PostgreSQL(可选) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=aidushu
# DB_PASSWORD=aidushu_dev_pass
# DB_NAME=aidushu
# 或 DATABASE_URL=postgres://aidushu:aidushu_dev_pass@localhost:5432/aidushu

# Redis(当前用内存替代,后续接真实 Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# 认证
JWT_SECRET=dev_jwt_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# 存储
UPLOAD_DIR=./uploads

# 短信/AI(开发期 mock)
SMS_PROVIDER=mock
AI_PROVIDER=mock
